<footer class="site-footer footer-default-style bg-soft-black">
    <div class="footer-widget-area ptb-100">
        <div class="container ml-b-60">
            <div class="row justify-content-between">
                <!-- About Footer -->
                <div class="col-lg-5">
                    <aside class="widget bt-about-footer-widget">
                        <div class="widget-content">
                            <div class="about-logo">
                                <a asp-controller="Home" asp-action="Index">
                                    <img src="~/images/logo/footer-logo.png" alt="Deliciousa Recipes Logo">
                                </a>
                            </div>
                            <div class="about-info">
                                <p>
                                    Deliciousa Recipe Studio — Discover, cook, and share authentic artisanal recipes crafted with love by passionate chefs for everyday home dining.
                                </p>
                                <div class="social-status">
                                    <a href="#"><span class="fab fa-facebook-f"></span></a>
                                    <a href="#"><span class="fab fa-twitter"></span></a>
                                    <a href="#"><span class="fab fa-instagram"></span></a>
                                    <a href="#"><span class="fab fa-pinterest"></span></a>
                                </div>
                            </div>
                        </div>
                    </aside>
                </div>

                <!-- Quick Navigation Links -->
                <div class="col-lg-3">
                    <aside class="widget widget_links">
                        <h4 class="widget-title text-white mb-3" style="font-size: 18px;">Quick Links</h4>
                        <div class="widget-content">
                            <ul>
                                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                                <li><a asp-controller="Recipes" asp-action="Index">Explore Recipes</a></li>
                                <li><a asp-controller="Recipes" asp-action="Create">+ Share a Recipe</a></li>
                                <li><a asp-controller="Home" asp-action="about">About Our Kitchen</a></li>
                                <li><a asp-controller="Account" asp-action="Login">Sign In / Register</a></li>
                            </ul>
                        </div>
                    </aside>
                </div>

                <!-- Newsletter / Portfolio note -->
                <div class="col-lg-4">
                    <aside class="widget tb-subscribe-widget">
                        <h2 class="widget-title"><span>Culinary</span> Newsletter</h2>
                        <div class="widget-content">
                            <p class="text-muted small mb-3">Subscribe to get seasonal recipes and weekly cooking tips straight to your inbox.</p>
                            <div class="subscribe-form">
                                <form class="dv-form" onsubmit="alert('Thank you for subscribing to Deliciousa recipes!'); return false;">
                                    <div class="form-group">
                                        <input placeholder="Enter your email address" type="email" required>
                                    </div>
                                    <button class="btn" type="submit">
                                        <span class="fa fa-paper-plane"></span>
                                    </button>
                                </form>
                            </div>
                            <p class="mt-3 text-muted" style="font-size: 12px;">© @DateTime.Now.Year Deliciousa Recipe Project. Portfolio Project by Zain.</p>
                        </div>
                    </aside>
                </div>
            </div>
        </div>
    </div>
</footer>