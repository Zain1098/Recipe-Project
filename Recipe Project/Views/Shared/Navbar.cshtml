<div class="navigation-area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="site-navigation">
                    <div class="site-navigation-inner">
                        <nav class="navigation">
                            <div class="menu-wrapper">
                                <div class="menu-content">
                                    <ul class="mainmenu">
                                        <li>
                                            <a asp-controller="Home" asp-action="Index">Home</a>
                                        </li>
                                        <li class="megamenu">
                                            <a asp-controller="Recipes" asp-action="Index">
                                                Recipes <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 3px;"></i>
                                            </a>
                                            <ul class="sub-menu megamenu-main megamenu-grid-menu">
                                                <li>
                                                    <div class="megamenu-recipe-grid">
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Breakfast" class="megamenu-recipe-item">
                                                            <div class="thumb-wrap">
                                                                <img src="~/images/foodmenu/menu/1.jpg" alt="Breakfast">
                                                            </div>
                                                            <div class="info">
                                                                <span class="badge-cat">Breakfast</span>
                                                                <h4 class="title">Pancakes & Shakshuka</h4>
                                                            </div>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Lunch" class="megamenu-recipe-item">
                                                            <div class="thumb-wrap">
                                                                <img src="~/images/foodmenu/menu12/food1.jpg" alt="Lunch">
                                                            </div>
                                                            <div class="info">
                                                                <span class="badge-cat">Lunch</span>
                                                                <h4 class="title">Creamy Tuscan Pasta</h4>
                                                            </div>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dinner" class="megamenu-recipe-item">
                                                            <div class="thumb-wrap">
                                                                <img src="~/images/foodmenu/menu12/food3.jpg" alt="Dinner">
                                                            </div>
                                                            <div class="info">
                                                                <span class="badge-cat">Dinner</span>
                                                                <h4 class="title">Royal Dum Biryani</h4>
                                                            </div>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dessert" class="megamenu-recipe-item">
                                                            <div class="thumb-wrap">
                                                                <img src="~/images/foodmenu/menu/5.jpg" alt="Dessert">
                                                            </div>
                                                            <div class="info">
                                                                <span class="badge-cat">Dessert</span>
                                                                <h4 class="title">Molten Lava Cake</h4>
                                                            </div>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Drinks" class="megamenu-recipe-item">
                                                            <div class="thumb-wrap">
                                                                <img src="~/images/foodmenu/menu/4.jpg" alt="Drinks">
                                                            </div>
                                                            <div class="info">
                                                                <span class="badge-cat">Drinks</span>
                                                                <h4 class="title">Mango Mint Mojito</h4>
                                                            </div>
                                                        </a>
                                                    </div>
                                                    <div class="megamenu-bottom-bar">
                                                        <a asp-controller="Recipes" asp-action="Index" class="view-all-link">
                                                            Browse All Recipes &rarr;
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Create" class="add-recipe-link">
                                                            + Submit a Recipe
                                                        </a>
                                                    </div>
                                                </li>
                                            </ul>
                                        </li>
                                        <li>
                                            <a asp-controller="Recipes" asp-action="Pantry" style="color: #c26747; font-weight: 600;">
                                                <i class="fas fa-magic me-1"></i> Fridge Matcher
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Recipes" asp-action="ShoppingList">
                                                <i class="fas fa-clipboard-list me-1"></i> Grocery List
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Recipes" asp-action="Create">+ Share Recipe</a>
                                        </li>
                                        <li>
                                            <a asp-controller="Home" asp-action="about">About Us</a>
                                        </li>
                                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                                        {
                                            <li>
                                                <a href="#" style="color: #d19f68; font-weight: 600;">
                                                    <i class="far fa-user-circle"></i> @User.Identity.Name
                                                </a>
                                                <ul class="sub-menu">
                                                    <li><a asp-controller="Recipes" asp-action="MyRecipes"><i class="fas fa-book-open"></i> My Recipes</a></li>
                                                    <li><a asp-controller="Recipes" asp-action="MySaved"><i class="fas fa-heart"></i> Saved Recipes</a></li>
                                                    <li><a asp-controller="Recipes" asp-action="Create"><i class="fas fa-plus"></i> Add New Recipe</a></li>
                                                    <li><a asp-controller="Account" asp-action="Logout" style="color: #e74c3c;"><i class="fas fa-sign-out-alt"></i> Sign Out</a></li>
                                                </ul>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <a asp-controller="Account" asp-action="Login">Sign In</a>
                                            </li>
                                            <li>
                                                <a asp-controller="Account" asp-action="Register" style="color: #d19f68; font-weight: 600;">Register</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>