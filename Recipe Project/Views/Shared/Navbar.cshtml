<div class="navigation-area">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="site-navigation">
                    <div class="site-navigation-inner">
                        <nav class="navigation">
                            <div class="menu-wrapper">
                                <div class="menu-content">
                                    <ul class="mainmenu">
                                        <li>
                                            <a asp-controller="Home" asp-action="Index">Home</a>
                                        </li>
                                        <li class="megamenu">
                                            <a asp-controller="Recipes" asp-action="Index">Recipes <i class="fas fa-chevron-down" style="font-size: 10px; margin-left: 3px;"></i></a>
                                            <ul class="sub-menu megamenu-main megamenu-carousel-menu">
                                                <li>
                                                    <div class="megamenu-carousel carousel-nav-dots owl-carousel">
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Breakfast" class="food-menu-item">
                                                            <figure class="food-thumb">
                                                                <img src="~/images/foodmenu/menu/1.jpg" alt="Breakfast">
                                                                <div class="overlay">
                                                                    <h3 class="title">Breakfast</h3>
                                                                </div>
                                                            </figure>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Lunch" class="food-menu-item">
                                                            <figure class="food-thumb">
                                                                <img src="~/images/foodmenu/menu12/food1.jpg" alt="Lunch">
                                                                <div class="overlay">
                                                                    <h3 class="title">Lunch</h3>
                                                                </div>
                                                            </figure>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dinner" class="food-menu-item">
                                                            <figure class="food-thumb">
                                                                <img src="~/images/foodmenu/menu12/food3.jpg" alt="Dinner">
                                                                <div class="overlay">
                                                                    <h3 class="title">Dinner</h3>
                                                                </div>
                                                            </figure>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Drinks" class="food-menu-item">
                                                            <figure class="food-thumb">
                                                                <img src="~/images/foodmenu/menu/4.jpg" alt="Drinks">
                                                                <div class="overlay">
                                                                    <h3 class="title">Drinks</h3>
                                                                </div>
                                                            </figure>
                                                        </a>
                                                        <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dessert" class="food-menu-item">
                                                            <figure class="food-thumb">
                                                                <img src="~/images/foodmenu/menu/5.jpg" alt="Dessert">
                                                                <div class="overlay">
                                                                    <h3 class="title">Dessert</h3>
                                                                </div>
                                                            </figure>
                                                        </a>
                                                    </div>
                                                </li>
                                            </ul>
                                        </li>
                                        <li>
                                            <a asp-controller="Recipes" asp-action="Create">+ Share Recipe</a>
                                        </li>
                                        <li>
                                            <a asp-controller="Home" asp-action="about">About Us</a>
                                        </li>
                                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                                        {
                                            <li>
                                                <a href="#" style="color: #d19f68; font-weight: 600;">
                                                    <i class="far fa-user-circle"></i> @User.Identity.Name
                                                </a>
                                                <ul class="sub-menu">
                                                    <li><a asp-controller="Recipes" asp-action="MyRecipes"><i class="fas fa-book-open"></i> My Recipes</a></li>
                                                    <li><a asp-controller="Recipes" asp-action="MySaved"><i class="fas fa-heart"></i> Saved Recipes</a></li>
                                                    <li><a asp-controller="Recipes" asp-action="Create"><i class="fas fa-plus"></i> Add New Recipe</a></li>
                                                    <li><a asp-controller="Account" asp-action="Logout" style="color: #e74c3c;"><i class="fas fa-sign-out-alt"></i> Sign Out</a></li>
                                                </ul>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <a asp-controller="Account" asp-action="Login">Sign In</a>
                                            </li>
                                            <li>
                                                <a asp-controller="Account" asp-action="Register" style="color: #d19f68; font-weight: 600;">Register</a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>