@model IEnumerable<Recipe_Project.Models.Recipe>
@{
    ViewData["Title"] = "Deliciousa - Artisanal Recipes & Gourmet Culinary Studio";
}

<!-- Hero Section with Background Video & Warm Ambient Overlay -->
<div class="video-bg position-relative overflow-hidden" style="min-height: 520px;">
    <video autoplay muted loop playsinline preload="metadata" poster="/images/header/header1.jpg">
        <source src="~/images/hero-video.mp4" type="video/mp4">
    </video>
    <div class="video-overlay" style="background: rgba(44, 34, 30, 0.58);"></div>

    <div class="hero-caption" style="position: absolute; width: 100%; top: 50%; transform: translateY(-50%); z-index: 5;">
        <div class="container text-center">
            <!-- Warm artisanal pill tag -->
            <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-3 rounded-pill" style="background: rgba(255, 255, 255, 0.18); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.25);">
                <span style="color: #f5ebe1; font-size: 13px; font-weight: 500; letter-spacing: 1px;">AUTHENTIC CULINARY STUDIO</span>
            </div>

            <h1 class="text-white fw-bold mb-3" style="font-family: 'Playfair Display', serif; font-size: clamp(30px, 5vw, 54px); text-shadow: 0 4px 20px rgba(0,0,0,0.5); line-height: 1.2;">
                Delicious Moments for Every Taste
            </h1>
            <p class="text-white-50 mx-auto mb-4" style="max-width: 620px; font-size: clamp(14px, 2vw, 17px); line-height: 1.7;">
                Experience culinary excellence crafted with passion, wholesome ingredients, and verified kitchen steps for everyday home cooking.
            </p>

            <!-- Integrated Live Search Bar Directly in Hero -->
            <div class="sk-hero-search mb-4">
                <form method="get" asp-controller="Recipes" asp-action="Index" class="d-flex align-items-center">
                    <i class="fas fa-search me-2" style="color: #c26747;"></i>
                    <input type="text" name="search" class="form-control" placeholder="Search pasta, biryani, cakes, drinks..." aria-label="Search recipes" />
                    <button type="submit" class="btn btn-sk-primary ms-2">Find Recipe</button>
                </form>
            </div>

            <!-- Quick Hero Action Buttons -->
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Recipes" asp-action="Index" class="btn btn-sk-primary">
                    <i class="fas fa-compass"></i> Explore All Recipes
                </a>
                <a asp-controller="Recipes" asp-action="Pantry" class="btn btn-sk-light" style="background: rgba(255,255,255,0.95); color: #2c221e;">
                    <i class="fas fa-magic" style="color: #c26747;"></i> What's In My Fridge?
                </a>
                <a asp-controller="Recipes" asp-action="Create" class="btn btn-sk-light">
                    <i class="fas fa-plus-circle text-danger"></i> + Share Recipe
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Browse By Category (Savoria Kitchen Circular Style) -->
<section class="py-5" style="background-color: #faf7f2; border-bottom: 1px solid #ede3da;">
    <div class="container">
        <div class="sk-section-header">
            <h2 class="sk-section-title">Browse By Category</h2>
            <div class="sk-section-divider"></div>
        </div>

        <div class="sk-category-row">
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Breakfast" class="sk-category-item">
                <div class="sk-cat-circle">🥞</div>
                <span class="sk-cat-name">Breakfast</span>
            </a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Lunch" class="sk-category-item">
                <div class="sk-cat-circle">🥗</div>
                <span class="sk-cat-name">Lunch</span>
            </a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dinner" class="sk-category-item">
                <div class="sk-cat-circle">🍲</div>
                <span class="sk-cat-name">Dinner</span>
            </a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dessert" class="sk-category-item">
                <div class="sk-cat-circle">🍰</div>
                <span class="sk-cat-name">Desserts</span>
            </a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Drinks" class="sk-category-item">
                <div class="sk-cat-circle">🍹</div>
                <span class="sk-cat-name">Drinks</span>
            </a>
            <a asp-controller="Recipes" asp-action="Index" class="sk-category-item">
                <div class="sk-cat-circle">🌟</div>
                <span class="sk-cat-name">All Recipes</span>
            </a>
        </div>
    </div>
</section>

<!-- Popular / Featured Recipes Grid (Matching Savoria Reference Layout) -->
<section class="py-5" style="background-color: #ffffff;">
    <div class="container py-3">
        <div class="sk-section-header">
            <p class="sk-section-subtitle">Chef's Signature Selection</p>
            <h2 class="sk-section-title">Popular Gourmet Dishes</h2>
            <div class="sk-section-divider"></div>

            <!-- Quick Filter Links (Reference Style: [Breakfast] [Lunch] [Dinner]) -->
            <div class="mt-3 d-flex justify-content-center gap-2 flex-wrap" style="font-size: 14px;">
                <a asp-controller="Recipes" asp-action="Index" class="text-decoration-none px-3 py-1 rounded-pill" style="background: #f5ebe1; color: #c26747; font-weight: 600;">All</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Breakfast" class="text-decoration-none px-3 py-1 rounded-pill text-muted">Breakfast</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Lunch" class="text-decoration-none px-3 py-1 rounded-pill text-muted">Lunch</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dinner" class="text-decoration-none px-3 py-1 rounded-pill text-muted">Dinner</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dessert" class="text-decoration-none px-3 py-1 rounded-pill text-muted">Dessert</a>
            </div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                var idx = 0;
                foreach (var recipe in Model)
                {
                    idx++;
                    var badgeLabel = (idx % 2 == 1) ? "Best Seller" : "Hot";
                    var badgeClass = (idx % 2 == 1) ? "bestseller" : "hot";

                    <div class="col-lg-3 col-md-6 col-12 mb-2">
                        <div class="sk-recipe-card">
                            <div class="sk-card-img-wrap">
                                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">
                                    <img src="@recipe.ImageUrl" alt="@recipe.Title" loading="lazy" onerror="this.src='/images/foodmenu/menu/1.jpg'" />
                                </a>
                                <span class="sk-badge-pill @badgeClass">@badgeLabel</span>
                                <span class="sk-time-pill">
                                    <i class="far fa-clock"></i> @(recipe.PrepTimeMinutes + recipe.CookTimeMinutes)m
                                </span>
                            </div>
                            <div class="sk-card-content">
                                <div class="sk-card-meta-top">
                                    <span class="sk-card-cat">@recipe.Category</span>
                                    <div class="d-flex align-items-center gap-1">
                                        @if (recipe.User?.IsVerifiedChef == true)
                                        {
                                            <span title="Verified Professional Chef" style="color: #1da1f2; font-size: 13px;">
                                                <i class="fas fa-check-circle"></i>
                                            </span>
                                        }
                                        <span class="sk-card-rating">
                                            <i class="fas fa-star"></i> @recipe.AverageRating
                                        </span>
                                    </div>
                                </div>
                                <h3 class="sk-card-title">
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">@recipe.Title</a>
                                </h3>
                                <p class="sk-card-desc">@recipe.Description</p>
                                <div class="sk-card-footer">
                                    <span><i class="fas fa-user-friends me-1"></i> @recipe.Servings Servings</span>
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">
                                        View Recipe &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="text-center mt-5">
            <a asp-controller="Recipes" asp-action="Index" class="btn btn-sk-outline px-4 py-2">
                Browse Full Culinary Catalog &rarr;
            </a>
        </div>
    </div>
</section>

<!-- Artisanal Culinary Story & Chef Inspiration -->
<section class="py-5" style="background-color: #faf7f2;">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-6 col-12 mb-4 mb-lg-0 text-center">
                <div class="position-relative d-inline-block">
                    <img src="~/images/about/about4.jpg" alt="Kitchen Chef Cooking" class="img-fluid rounded-4 shadow-sm" style="max-height: 440px; width: 100%; object-fit: cover; border: 4px solid #ffffff;" />
                    <div class="position-absolute bottom-0 start-0 p-3 m-3 rounded-3 shadow" style="background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(5px); text-align: left; max-width: 200px;">
                        <h5 class="fw-bold mb-0 text-dark" style="font-size: 16px;">100% Tested</h5>
                        <small class="text-muted" style="font-size: 12px;">Verified measurements & foolproof steps</small>
                    </div>
                </div>
            </div>
            <div class="col-lg-6 col-12 ps-lg-5">
                <p class="sk-section-subtitle text-start">Authentic Kitchen Heritage</p>
                <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(26px, 3.5vw, 36px); color: #2c221e; margin-bottom: 18px;">
                    Passion For Wholesome, Flavorful Food
                </h2>
                <p style="color: #786b64; line-height: 1.8; margin-bottom: 20px;">
                    Whether you are cooking a quick weekday dinner or preparing a weekend feast for family, Deliciousa provides clear, tested steps, verified spice ratios, and chef secrets to guarantee kitchen success.
                </p>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-3 shadow-sm border text-center" style="border-color: #ede3da !important;">
                            <h3 class="fw-bold mb-1" style="color: #c26747;">100%</h3>
                            <small class="text-muted">Free Community Recipes</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-white rounded-3 shadow-sm border text-center" style="border-color: #ede3da !important;">
                            <h3 class="fw-bold mb-1" style="color: #e59819;">4.9 ★</h3>
                            <small class="text-muted">Home Cook Ratings</small>
                        </div>
                    </div>
                </div>

                <a asp-controller="Home" asp-action="about" class="btn btn-sk-primary">
                    Learn More About Our Kitchen &rarr;
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Bottom Artisanal CTA Banner (Directly Matching Savoria Reference Bar) -->
<section class="py-4" style="background-color: #faf7f2;">
    <div class="container pb-4">
        <div class="sk-bottom-banner text-center">
            <div class="container">
                <h2>Taste the Best, Share Your Recipe</h2>
                <p>Got a signature dish your family adores? Upload your step-by-step recipe and inspire our community of food lovers!</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a asp-controller="Recipes" asp-action="Create" class="btn btn-sk-light">
                        <i class="fas fa-plus-circle me-1" style="color: #c26747;"></i> + Share Your Recipe
                    </a>
                    <a asp-controller="Recipes" asp-action="Index" class="btn btn-sk-outline text-white border-white">
                        Browse Recipes
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>