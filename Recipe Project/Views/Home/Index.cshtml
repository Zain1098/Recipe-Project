@model IEnumerable<Recipe_Project.Models.Recipe>
@{
    ViewData["Title"] = "Deliciousa - Artisanal Recipes & Culinary Inspiration";
}

<!-- Video Hero Section -->
<div class="video-bg">
    <video autoplay muted loop playsinline>
        <source src="~/images/JW s GRILL NYK Restaurant Commercial.mp4" type="video/mp4">
    </video>
    <div class="video-overlay"></div>
    <div class="hero-caption">
        <div class="container text-center">
            <p class="hero-subtitle-responsive text-warning mb-0" style="font-family: 'Herr Von Muellerhoff', cursive;">Authentic Culinary Arts</p>
            <h1 class="hero-title-responsive text-white fw-bold mb-3" style="font-family: 'Playfair Display', serif; text-shadow: 0 4px 15px rgba(0,0,0,0.5);">
                Discover & Cook World-Class Recipes
            </h1>
            <p class="hero-desc-responsive text-white-50 mx-auto mb-4" style="max-width: 650px;">
                From hearty breakfast skillets to slow-cooked royal dinners and decadent desserts. Tested and perfected for everyday home dining.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a asp-controller="Recipes" asp-action="Index" class="btn btn-default btn-primary px-4 py-3">
                    EXPLORE ALL RECIPES
                </a>
                <a asp-controller="Recipes" asp-action="Create" class="btn btn-default btn-outline text-white border-white px-4 py-3">
                    + SHARE YOUR RECIPE
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Quick Category Bar -->
<div class="py-4 bg-light border-bottom">
    <div class="container">
        <div class="filter-pills-scroll">
            <a asp-controller="Recipes" asp-action="Index" class="filter-btn active">🌟 All Recipes</a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Breakfast" class="filter-btn">🥞 Breakfast</a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Lunch" class="filter-btn">🥗 Lunch</a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dinner" class="filter-btn">🍲 Dinner</a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dessert" class="filter-btn">🍰 Dessert</a>
            <a asp-controller="Recipes" asp-action="Index" asp-route-category="Drinks" class="filter-btn">🍹 Drinks</a>
        </div>
    </div>
</div>

<!-- Featured Recipes Section -->
<section class="py-5 bg-white">
    <div class="container py-4">
        <div class="text-center mb-5">
            <p style="font-family: 'Herr Von Muellerhoff', cursive; font-size: 38px; color: #d19f68; margin-bottom: 0;">Chef's Special Selection</p>
            <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(28px, 4vw, 38px); font-weight: 700;">Featured Gourmet Dishes</h2>
            <div style="width: 50px; height: 3px; background: #d19f68; margin: 12px auto;"></div>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                foreach (var recipe in Model)
                {
                    <div class="col-lg-3 col-md-6 col-12 mb-4">
                        <div class="recipe-home-card h-100">
                            <div class="thumb">
                                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">
                                    <img src="@recipe.ImageUrl" alt="@recipe.Title" onerror="this.src='/images/foodmenu/menu/1.jpg'" />
                                </a>
                                <span class="cat-badge">@recipe.Category</span>
                                <span class="time-badge"><i class="far fa-clock"></i> @(recipe.PrepTimeMinutes + recipe.CookTimeMinutes)m</span>
                            </div>
                            <div class="body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-light text-muted border">@recipe.Difficulty</span>
                                    <span class="text-warning" style="font-size: 13px;">
                                        <i class="fas fa-star"></i> <strong>@recipe.AverageRating</strong> (@recipe.TotalReviews)
                                    </span>
                                </div>
                                <h4 class="title">
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">@recipe.Title</a>
                                </h4>
                                <p class="desc">@recipe.Description</p>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top text-muted" style="font-size: 12px;">
                                    <span><i class="fas fa-utensils"></i> @recipe.Servings Servings</span>
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id" style="color: #d19f68; font-weight: 600;">View Recipe &rarr;</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div class="text-center mt-3">
            <a asp-controller="Recipes" asp-action="Index" class="btn btn-default btn-outline px-4 py-2">
                Browse All Recipes &rarr;
            </a>
        </div>
    </div>
</section>

<!-- Story Section -->
<section class="py-5" style="background: #faf8f5;">
    <div class="container py-4">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0 text-center">
                <img src="~/images/about/about4.jpg" alt="Kitchen Chef" class="img-fluid rounded shadow" style="max-height: 400px; object-fit: cover;" />
            </div>
            <div class="col-lg-6 ps-lg-4">
                <p style="font-family: 'Herr Von Muellerhoff', cursive; font-size: 38px; color: #d19f68; margin-bottom: 0;">Our Culinary Story</p>
                <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(26px, 3.5vw, 34px); margin-bottom: 20px;">Passion For Wholesome, Flavorful Food</h2>
                <p style="color: #666; line-height: 1.8; margin-bottom: 18px;">
                    Whether you are an aspiring amateur cook or a seasoned culinary enthusiast, Deliciousa provides clear, tested steps, verified measurements, and helpful cooking tips to make every meal memorable.
                </p>
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div class="p-3 bg-white rounded shadow-sm border text-center">
                            <h3 class="fw-bold text-warning mb-1">100%</h3>
                            <small class="text-muted">Free Community Recipes</small>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-white rounded shadow-sm border text-center">
                            <h3 class="fw-bold text-warning mb-1">5 ★</h3>
                            <small class="text-muted">Home Cook Ratings</small>
                        </div>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="about" class="btn btn-default btn-primary">About Our Kitchen</a>
            </div>
        </div>
    </div>
</section>

<!-- Community Call-to-Action -->
<section class="py-5 bg-white">
    <div class="container py-3">
        <div class="cta-box">
            <h2 style="font-family: 'Playfair Display', serif; font-size: clamp(24px, 3.5vw, 34px); margin-bottom: 14px;">Share Your Favorite Recipe</h2>
            <p style="max-width: 600px; margin: 0 auto 25px; color: #666; font-size: 16px;">
                Got a mouth-watering recipe your family loves? Join Deliciousa, upload your photos and steps, and inspire thousands of fellow home cooks!
            </p>
            <a asp-controller="Recipes" asp-action="Create" class="btn btn-default btn-primary px-4 py-3 fw-bold">
                + Publish Your Recipe Today
            </a>
        </div>
    </div>
</section>