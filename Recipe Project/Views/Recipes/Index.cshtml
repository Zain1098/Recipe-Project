@model IEnumerable<Recipe_Project.Models.Recipe>
@{
    ViewData["Title"] = ViewBag.PageHeading ?? "Explore Recipes - Deliciousa";
    var categories = ViewBag.AllCategories as List<string> ?? new List<string>();
    var currentCat = ViewBag.CurrentCategory as string ?? "All";
    var currentDiff = ViewBag.CurrentDifficulty as string ?? "All";
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentSort = ViewBag.CurrentSort as string ?? "newest";
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <h2 class="page-title text-white fw-bold">@(ViewBag.PageHeading ?? "Discover Delicious Recipes")</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Recipes</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <!-- Filter & Search Section with Warm Artisanal Palette -->
    <div class="p-3 p-md-4 mb-4 rounded-4 shadow-sm" style="background-color: #ffffff; border: 1px solid #ede3da;">
        <form method="get" asp-controller="Recipes" asp-action="Index">
            <div class="row g-2 align-items-center">
                <div class="col-lg-5 col-md-12">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0" style="border-color: #ede3da;"><i class="fas fa-search text-muted"></i></span>
                        <input type="text" name="search" value="@currentSearch" class="form-control border-start-0" style="border-color: #ede3da;" placeholder="Search title, ingredients, cuisine..." />
                    </div>
                </div>
                <div class="col-lg-3 col-6">
                    <select name="category" class="form-select" style="border-color: #ede3da;">
                        <option value="All">All Categories</option>
                        @foreach (var cat in categories)
                        {
                            if (cat == currentCat)
                            {
                                <option value="@cat" selected="selected">@cat</option>
                            }
                            else
                            {
                                <option value="@cat">@cat</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-6">
                    <select name="sort" class="form-select" style="border-color: #ede3da;">
                        <option value="newest" selected="@(currentSort == "newest" ? "selected" : null)">Newest First</option>
                        <option value="popular" selected="@(currentSort == "popular" ? "selected" : null)">Most Popular</option>
                        <option value="rating" selected="@(currentSort == "rating" ? "selected" : null)">Top Rated</option>
                    </select>
                </div>
                <div class="col-lg-2 col-12">
                    <button type="submit" class="btn btn-sk-primary w-100 py-2">Search</button>
                </div>
            </div>

            <!-- Horizontal Scrollable Category Pills -->
            <div class="mt-3 filter-pills-scroll">
                <a asp-controller="Recipes" asp-action="Index" class="filter-btn @(currentCat == "All" ? "active" : "")">All</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Breakfast" class="filter-btn @(currentCat == "Breakfast" ? "active" : "")">🥞 Breakfast</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Lunch" class="filter-btn @(currentCat == "Lunch" ? "active" : "")">🥗 Lunch</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dinner" class="filter-btn @(currentCat == "Dinner" ? "active" : "")">🍲 Dinner</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Dessert" class="filter-btn @(currentCat == "Dessert" ? "active" : "")">🍰 Dessert</a>
                <a asp-controller="Recipes" asp-action="Index" asp-route-category="Drinks" class="filter-btn @(currentCat == "Drinks" ? "active" : "")">🍹 Drinks</a>
            </div>
        </form>
    </div>

    <!-- Smart Kitchen Callout Banner -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4 p-3 rounded-4 shadow-sm" style="background: linear-gradient(135deg, #faf7f2, #f5ebe1); border: 1px solid #ede3da;">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle p-2 bg-white shadow-sm d-flex align-items-center justify-content-center" style="width: 42px; height: 42px; font-size: 20px;">
                🧊
            </div>
            <div>
                <h6 class="mb-0 fw-bold" style="color: #2c221e;">Don't know what to cook today?</h6>
                <small class="text-muted">Pick what ingredients you already have in your kitchen, and we'll find recipes you can make!</small>
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Recipes" asp-action="Pantry" class="btn btn-sm btn-sk-primary">
                <i class="fas fa-magic me-1"></i> What's In My Fridge?
            </a>
            <a asp-controller="Recipes" asp-action="ShoppingList" class="btn btn-sm btn-outline-dark">
                <i class="fas fa-clipboard-list me-1"></i> Grocery List
            </a>
        </div>
    </div>

    <!-- Recipes Grid -->
    @if (!Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 p-4 shadow-sm border" style="border-color: #ede3da !important;">
            <img src="~/images/foodmenu/small/1.png" alt="Empty" style="width: 80px; opacity: 0.5;" />
            <h4 class="mt-3 fw-bold" style="color: #2c221e;">No Recipes Found</h4>
            <p class="text-muted">Try searching with a different keyword or explore all categories.</p>
            <a asp-controller="Recipes" asp-action="Index" class="btn btn-sk-primary mt-2">View All Recipes</a>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @{
                var cardIdx = 0;
            }
            @foreach (var recipe in Model)
            {
                cardIdx++;
                var badgeLabel = (cardIdx % 2 == 1) ? "Best Seller" : "Hot";
                var badgeClass = (cardIdx % 2 == 1) ? "bestseller" : "hot";

                <div class="col-lg-4 col-md-6 col-12 mb-3">
                    <div class="sk-recipe-card">
                        <div class="sk-card-img-wrap" style="height: 240px;">
                            <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">
                                <img src="@recipe.ImageUrl" alt="@recipe.Title" loading="lazy" onerror="this.src='/images/foodmenu/menu/1.jpg'" />
                            </a>
                            <span class="sk-badge-pill @badgeClass">@badgeLabel</span>
                            <span class="sk-time-pill">
                                <i class="far fa-clock"></i> @(recipe.PrepTimeMinutes + recipe.CookTimeMinutes) mins
                            </span>
                        </div>
                        <div class="sk-card-content">
                            <div class="sk-card-meta-top">
                                <span class="sk-card-cat">@recipe.Category</span>
                                <div class="d-flex align-items-center gap-1">
                                    @if (recipe.User?.IsVerifiedChef == true)
                                    {
                                        <span title="Verified Professional Chef" style="color: #1da1f2; font-size: 13px;">
                                            <i class="fas fa-check-circle"></i>
                                        </span>
                                    }
                                    <span class="sk-card-rating">
                                        <i class="fas fa-star"></i> <strong>@recipe.AverageRating</strong> <span class="text-muted small">(@recipe.TotalReviews)</span>
                                    </span>
                                </div>
                            </div>
                            <h3 class="sk-card-title">
                                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">@recipe.Title</a>
                            </h3>
                            <p class="sk-card-desc">@recipe.Description</p>
                            <div class="sk-card-footer">
                                <span><i class="fas fa-utensils me-1 text-muted"></i> @recipe.Servings servings</span>
                                <span><i class="far fa-eye me-1 text-muted"></i> @recipe.ViewsCount views</span>
                                <a asp-controller="Recipes" asp-action="Details" asp-route-id="@recipe.Id">
                                    Details &rarr;
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
