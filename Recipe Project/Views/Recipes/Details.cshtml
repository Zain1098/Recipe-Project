@model Recipe_Project.Models.Recipe
@{
    ViewData["Title"] = $"{Model.Title} - Recipe Details";
    var relatedRecipes = ViewBag.RelatedRecipes as List<Recipe_Project.Models.Recipe> ?? new List<Recipe_Project.Models.Recipe>();
    var isSaved = ViewBag.IsSaved as bool? ?? false;
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isAuthorOrAdmin = User.Identity != null && User.Identity.IsAuthenticated && (currentUserId == Model.UserId.ToString() || User.IsInRole("Admin"));
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <h2 class="page-title text-white fw-bold">@Model.Title</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Recipes" asp-action="Index" class="text-white-50">Recipes</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">@Model.Category</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row g-4">
        <div class="col-lg-8 col-12">
            <!-- Hero Recipe Image -->
            <div class="mb-4 position-relative rounded-4 overflow-hidden shadow-sm">
                <img src="@Model.ImageUrl" alt="@Model.Title" class="img-fluid w-100" style="max-height: 440px; object-fit: cover;" onerror="this.src='/images/foodmenu/menu/1.jpg'" />
                <div class="position-absolute top-0 end-0 p-3">
                    <button id="saveBtn" class="btn btn-light shadow-sm" onclick="toggleSave(@Model.Id)" style="border-radius: 50%; width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;">
                        <i id="heartIcon" class="@(isSaved ? "fas" : "far") fa-heart" style="color: #e74c3c; font-size: 18px;"></i>
                    </button>
                </div>
            </div>

            <!-- Author & Admin Edit/Delete Controls -->
            @if (isAuthorOrAdmin)
            {
                <div class="d-flex gap-2 justify-content-end mb-3">
                    <a asp-controller="Recipes" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-dark">
                        <i class="fas fa-edit"></i> Edit Recipe
                    </a>
                    <form asp-controller="Recipes" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this recipe?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-trash"></i> Delete
                        </button>
                    </form>
                </div>
            }

            <!-- Story / Description -->
            <h3 style="font-family: 'Playfair Display', serif; font-size: clamp(22px, 3vw, 28px); margin-bottom: 12px;">About this Recipe</h3>
            <p style="font-size: 15px; line-height: 1.8; color: #555; margin-bottom: 25px;">@Model.Description</p>

            <!-- Responsive Meta Box -->
            <div class="recipe-meta-box">
                <div class="meta-item">
                    <div class="label"><i class="far fa-clock text-warning"></i> Prep Time</div>
                    <div class="val">@Model.PrepTimeMinutes m</div>
                </div>
                <div class="meta-item">
                    <div class="label"><i class="fas fa-fire text-danger"></i> Cook Time</div>
                    <div class="val">@Model.CookTimeMinutes m</div>
                </div>
                <div class="meta-item">
                    <div class="label"><i class="fas fa-user-friends text-info"></i> Servings</div>
                    <div class="val">@Model.Servings</div>
                </div>
                <div class="meta-item">
                    <div class="label"><i class="fas fa-signal text-success"></i> Difficulty</div>
                    <div class="val">@Model.Difficulty</div>
                </div>
                <div class="meta-item">
                    <div class="label"><i class="fas fa-star text-warning"></i> Rating</div>
                    <div class="val">@Model.AverageRating <span style="font-size: 12px; font-weight: normal; color: #888;">(@Model.TotalReviews)</span></div>
                </div>
            </div>

            <!-- Ingredients Card -->
            <div class="card border-0 shadow-sm mb-4 rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-carrot text-warning me-2"></i> Ingredients</h4>
                    <small class="text-muted">Click any item to check it off as you prepare!</small>
                </div>
                <div class="card-body p-0">
                    @foreach (var ing in Model.Ingredients)
                    {
                        var ingId = "ing_" + Math.Abs(ing.GetHashCode());
                        <div class="ingredient-item">
                            <input type="checkbox" class="form-check-input me-3" style="width: 18px; height: 18px;" id="@ingId" />
                            <label class="form-check-label mb-0" for="@ingId" style="font-size: 14px; cursor: pointer;">@ing</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Instructions Card -->
            <div class="card border-0 shadow-sm mb-5 rounded-3 overflow-hidden">
                <div class="card-header bg-white py-3 border-bottom">
                    <h4 class="mb-0 fw-bold"><i class="fas fa-tasks text-success me-2"></i> Step-by-Step Instructions</h4>
                </div>
                <div class="card-body p-3 p-md-4">
                    @{
                        var stepNum = 1;
                    }
                    @foreach (var step in Model.Instructions)
                    {
                        <div class="d-flex mb-4 align-items-start">
                            <div class="step-number">@stepNum</div>
                            <div class="step-content">
                                <h6 class="fw-bold mb-1">Step @stepNum</h6>
                                <p class="mb-0">@step</p>
                            </div>
                        </div>
                        stepNum++;
                    }
                </div>
            </div>

            <!-- Reviews Section -->
            <div class="reviews-section mt-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 style="font-family: 'Playfair Display', serif;">Reviews (@Model.Reviews.Count)</h3>
                    <div class="text-warning">
                        <i class="fas fa-star"></i> <strong>@Model.AverageRating / 5.0</strong>
                    </div>
                </div>

                @if (!Model.Reviews.Any())
                {
                    <p class="text-muted fst-italic">Be the first to review this recipe!</p>
                }
                else
                {
                    @foreach (var rev in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="review-card">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center">
                                    <img src="/images/author/user.png" alt="User" style="width: 34px; height: 34px; border-radius: 50%; margin-right: 10px;" />
                                    <div>
                                        <strong>@rev.AuthorName</strong>
                                        <small class="text-muted d-block" style="font-size: 11px;">@rev.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </div>
                                </div>
                                <div class="text-warning small">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        <i class="@(i <= rev.Rating ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                            </div>
                            <p class="mb-0 text-secondary" style="font-size: 14px; line-height: 1.6;">@rev.Comment</p>
                        </div>
                    }
                }

                <!-- Review Form -->
                <div class="card p-3 p-md-4 border-0 shadow-sm mt-4 rounded-3" style="background: #faf8f5;">
                    <h4 class="fw-bold mb-3" style="font-size: 18px;">Leave Feedback & Rating</h4>
                    <form asp-controller="Recipes" asp-action="AddReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="recipeId" value="@Model.Id" />

                        <div class="row g-2 mb-3">
                            <div class="col-md-6 col-12">
                                <label class="form-label small fw-bold">Your Name</label>
                                <input type="text" name="authorName" class="form-control" value="@User.Identity?.Name" placeholder="e.g. Alex" required />
                            </div>
                            <div class="col-md-6 col-12">
                                <label class="form-label small fw-bold">Rating</label>
                                <select name="rating" class="form-select">
                                    <option value="5">⭐⭐⭐⭐⭐ (5 - Outstanding)</option>
                                    <option value="4">⭐⭐⭐⭐ (4 - Delicious)</option>
                                    <option value="3">⭐⭐⭐ (3 - Good)</option>
                                    <option value="2">⭐⭐ (2 - Fair)</option>
                                    <option value="1">⭐ (1 - Needs Improvement)</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold">Your Comments</label>
                            <textarea name="comment" rows="3" class="form-control" placeholder="Share your thoughts or any cooking tips..." required></textarea>
                        </div>

                        <button type="submit" class="btn btn-default btn-primary py-2 px-4">Submit Review</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4 col-12">
            <!-- Author Profile Card -->
            <div class="card p-4 border-0 shadow-sm text-center mb-4 rounded-3">
                <img src="@(Model.User?.AvatarUrl ?? "/images/author/author1.jpg")" alt="Chef" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin: 0 auto 12px; border: 3px solid #d19f68;" />
                <h5 class="fw-bold mb-1">@(Model.User?.FullName ?? "Chef Zain")</h5>
                <p class="text-muted small mb-2">Recipe Creator</p>
                <p class="text-secondary small mb-3">Passionate about authentic flavors, wholesome ingredients, and restaurant-quality home cooking.</p>
                <a asp-controller="Recipes" asp-action="Index" class="btn btn-sm btn-outline-secondary">Browse More Recipes</a>
            </div>

            <!-- Related Recipes -->
            @if (relatedRecipes.Any())
            {
                <div class="card p-3 p-md-4 border-0 shadow-sm rounded-3">
                    <h5 class="fw-bold mb-3">More in @Model.Category</h5>
                    @foreach (var rel in relatedRecipes)
                    {
                        <div class="d-flex mb-3 align-items-center">
                            <img src="@rel.ImageUrl" alt="@rel.Title" style="width: 65px; height: 65px; border-radius: 8px; object-fit: cover; margin-right: 12px;" onerror="this.src='/images/foodmenu/menu/1.jpg'" />
                            <div>
                                <h6 style="font-size: 13px; margin-bottom: 3px; line-height: 1.3;">
                                    <a asp-controller="Recipes" asp-action="Details" asp-route-id="@rel.Id" class="text-dark">@rel.Title</a>
                                </h6>
                                <small class="text-muted"><i class="far fa-clock"></i> @(rel.PrepTimeMinutes + rel.CookTimeMinutes) mins</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleSave(recipeId) {
            @if (User.Identity == null || !User.Identity.IsAuthenticated)
            {
                <text>
                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                return;
                </text>
            }

            fetch('/Recipes/ToggleFavorite?recipeId=' + recipeId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    var icon = document.getElementById('heartIcon');
                    if (data.isSaved) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                    }
                    alert(data.message);
                }
            })
            .catch(err => console.error(err));
        }
    </script>
}
