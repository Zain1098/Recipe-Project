@{
    ViewData["Title"] = "Smart Grocery Shopping List - Deliciousa";
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 mb-2 rounded-pill" style="background: rgba(194, 103, 71, 0.35); border: 1px solid rgba(255, 255, 255, 0.3);">
            <span style="color: #fff; font-size: 13px; font-weight: 600; letter-spacing: 0.5px;">🛒 PANTRY & STORE ASSISTANT</span>
        </div>
        <h2 class="page-title text-white fw-bold">Grocery Shopping List</h2>
        <p class="text-white-50 mx-auto mb-0" style="max-width: 600px; font-size: 15px;">
            Keep track of recipe ingredients and household items. Cross off items as you shop in-store, or export via Email / Clipboard!
        </p>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-12">
            <!-- Action Toolbar Card -->
            <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4" style="background: #ffffff; border: 1px solid #ede3da !important;">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-3 border-bottom">
                    <div>
                        <h4 class="fw-bold mb-0" style="font-family: 'Playfair Display', serif; color: #2c221e;">
                            My Grocery Items (<span id="totalItemsCount">0</span>)
                        </h4>
                        <small class="text-muted" id="pendingItemsCount">0 remaining to purchase</small>
                    </div>

                    <!-- Export Actions -->
                    <div class="d-flex gap-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-dark" onclick="copyListToClipboard()" title="Copy formatted list for WhatsApp or Notes">
                            <i class="far fa-copy me-1"></i> Copy List
                        </button>
                        <button class="btn btn-sm btn-outline-primary" onclick="emailList()" title="Open in your email client">
                            <i class="far fa-envelope me-1"></i> Email List
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" onclick="window.print()" title="Print physical checklist">
                            <i class="fas fa-print me-1"></i> Print
                        </button>
                    </div>
                </div>

                <!-- Add Custom Item Input -->
                <div class="input-group mb-4">
                    <span class="input-group-text bg-white" style="border-color: #ede3da;">
                        <i class="fas fa-cart-plus text-muted"></i>
                    </span>
                    <input type="text" id="newGroceryInput" class="form-control" style="border-color: #ede3da;" placeholder="Add grocery item (e.g. 1kg Basmati Rice, 6 Eggs, Butter)..." />
                    <button class="btn btn-sk-primary px-4" onclick="addCustomItem()">+ Add Item</button>
                </div>

                <!-- Shopping List Checklist Items -->
                <div id="shoppingListContainer" class="mb-4">
                    <!-- Items rendered dynamically via JS -->
                </div>

                <!-- List Management Actions -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <button class="btn btn-sm btn-outline-secondary" onclick="clearCheckedItems()">
                        <i class="fas fa-broom me-1"></i> Clear Purchased Items
                    </button>
                    <button class="btn btn-sm btn-outline-danger" onclick="clearAllItems()">
                        <i class="fas fa-trash-alt me-1"></i> Clear Entire List
                    </button>
                </div>
            </div>

            <!-- Quick Navigation Helper -->
            <div class="text-center">
                <a asp-controller="Recipes" asp-action="Index" class="btn btn-sm btn-link text-decoration-none text-muted">
                    &larr; Browse Recipes to add more ingredients
                </a>
                <span class="mx-2 text-muted">&bull;</span>
                <a asp-controller="Recipes" asp-action="Pantry" class="btn btn-sm btn-link text-decoration-none" style="color: #c26747;">
                    Check "What's in My Fridge?" &rarr;
                </a>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .grocery-item-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 8px;
            background: #faf8f5;
            border: 1px solid #ede3da;
            transition: all 0.2s ease;
        }
        .grocery-item-row:hover {
            background: #f4ede4;
        }
        .grocery-item-row.checked {
            background: #f0f0f0;
            opacity: 0.65;
            border-color: #e0e0e0;
        }
        .grocery-item-row.checked .grocery-name {
            text-decoration: line-through;
            color: #888;
        }
        .grocery-check-input {
            width: 20px;
            height: 20px;
            cursor: pointer;
            accent-color: #c26747;
        }
        .grocery-delete-btn {
            background: none;
            border: none;
            color: #b0a59f;
            cursor: pointer;
            padding: 4px 8px;
            border-radius: 6px;
            transition: color 0.2s;
        }
        .grocery-delete-btn:hover {
            color: #dc3545;
            background: rgba(220, 53, 69, 0.1);
        }

        @@media print {
            .site-header, .site-footer, .page-title-area, .btn, .input-group, .grocery-delete-btn, nav {
                display: none !important;
            }
            body {
                background: white !important;
                color: black !important;
            }
            .grocery-item-row {
                border: 1px solid #ccc !important;
                background: white !important;
            }
        }
    </style>
}

@section Scripts {
    <script>
        const STORAGE_KEY = 'deliciousa_shopping_list';

        function getItems() {
            return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
        }

        function saveItems(items) {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
            renderList();
        }

        function renderList() {
            const items = getItems();
            const container = document.getElementById('shoppingListContainer');
            const totalCount = document.getElementById('totalItemsCount');
            const pendingCount = document.getElementById('pendingItemsCount');

            totalCount.innerText = items.length;
            const remaining = items.filter(i => !i.checked).length;
            pendingCount.innerText = `${remaining} remaining to purchase`;

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5">
                        <i class="fas fa-shopping-basket text-muted" style="font-size: 42px; opacity: 0.4;"></i>
                        <h5 class="mt-3 fw-bold text-muted">Your Shopping List is Empty</h5>
                        <p class="small text-muted mb-0">Add ingredients manually above, or click <strong>"+ Add to Shopping List"</strong> from any recipe page!</p>
                    </div>
                `;
                return;
            }

            let html = '';
            items.forEach((item, index) => {
                html += `
                    <div class="grocery-item-row ${item.checked ? 'checked' : ''}">
                        <div class="d-flex align-items-center gap-3 flex-grow-1">
                            <input type="checkbox" class="grocery-check-input" ${item.checked ? 'checked' : ''} onchange="toggleItem(${index})" id="item_${index}" />
                            <label class="grocery-name mb-0" for="item_${index}" style="cursor: pointer; font-size: 15px;">
                                ${escapeHtml(item.name)}
                            </label>
                        </div>
                        <button class="grocery-delete-btn" onclick="deleteItem(${index})" title="Remove item">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        function toggleItem(index) {
            const items = getItems();
            if (items[index]) {
                items[index].checked = !items[index].checked;
                saveItems(items);
            }
        }

        function deleteItem(index) {
            const items = getItems();
            items.splice(index, 1);
            saveItems(items);
        }

        function addCustomItem() {
            const input = document.getElementById('newGroceryInput');
            const val = input.value.trim();
            if (!val) return;

            const items = getItems();
            items.push({ name: val, checked: false });
            input.value = '';
            saveItems(items);
        }

        document.getElementById('newGroceryInput').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                addCustomItem();
            }
        });

        function clearCheckedItems() {
            let items = getItems();
            items = items.filter(i => !i.checked);
            saveItems(items);
        }

        function clearAllItems() {
            if (confirm('Are you sure you want to clear your entire grocery shopping list?')) {
                saveItems([]);
            }
        }

        function copyListToClipboard() {
            const items = getItems();
            if (items.length === 0) {
                alert('Your shopping list is empty.');
                return;
            }

            let text = '🛒 DELICIOUSA GROCERY SHOPPING LIST:\n\n';
            items.forEach(i => {
                text += `${i.checked ? '✅' : '⬜'} ${i.name}\n`;
            });

            navigator.clipboard.writeText(text).then(() => {
                alert('Shopping list copied to clipboard! You can now paste it into WhatsApp, Notes, or Messages.');
            }).catch(err => {
                alert('Failed to copy: ' + err);
            });
        }

        function emailList() {
            const items = getItems();
            if (items.length === 0) {
                alert('Your shopping list is empty.');
                return;
            }

            let subject = encodeURIComponent('Deliciousa Recipe Grocery List');
            let bodyText = 'Here is your grocery shopping list from Deliciousa:\n\n';
            items.forEach(i => {
                bodyText += `${i.checked ? '[x]' : '[ ]'} ${i.name}\n`;
            });
            bodyText += '\nGenerated via Deliciousa Artisanal Recipes.';

            let body = encodeURIComponent(bodyText);
            window.location.href = `mailto:?subject=${subject}&body=${body}`;
        }

        function escapeHtml(text) {
            var div = document.createElement('div');
            div.appendChild(document.createTextNode(text));
            return div.innerHTML;
        }

        // Initialize on load
        document.addEventListener('DOMContentLoaded', renderList);
    </script>
}
