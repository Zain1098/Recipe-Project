@model Recipe_Project.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account - Deliciousa Recipes";
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <h2 class="page-title text-white fw-bold">Sign Up</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Sign Up</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-12">
            <div class="form-card">
                <h3 class="fw-bold mb-1" style="font-family: 'Playfair Display', serif;">Join Our Foodie Community</h3>
                <p class="text-muted mb-4 small">Save favorites, leave star reviews, and publish your own recipes.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold small">Full Name *</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Zain Malik" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold small">Email Address *</label>
                        <input asp-for="Email" class="form-control" placeholder="e.g. zain@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small">Password (Min 6 chars) *</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small">Confirm Password *</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <!-- Professional Chef Registration Option -->
                    <div class="p-3 mb-4 rounded-3" style="background: #faf7f2; border: 1.5px dashed #c26747;">
                        <div class="form-check form-switch mb-0 d-flex align-items-center">
                            <input asp-for="RegisterAsChef" class="form-check-input me-2" type="checkbox" id="chefToggleCheck" onchange="toggleChefFields(this)" style="cursor: pointer; width: 38px; height: 20px; accent-color: #c26747;" />
                            <label class="form-check-label fw-bold small mb-0" for="chefToggleCheck" style="cursor: pointer; color: #2c221e;">
                                👨‍🍳 Register as a Professional Chef
                            </label>
                        </div>
                        <small class="text-muted d-block mt-1" style="font-size: 11px;">
                            Check this to receive the official <strong>Verified Chef Blue Checkmark</strong> on your recipes.
                        </small>

                        <div id="chefTitleContainer" class="mt-3 d-none">
                            <label asp-for="ChefTitle" class="form-label fw-bold small">Chef Specialty / Title</label>
                            <input asp-for="ChefTitle" class="form-control form-control-sm" placeholder="e.g. Executive Chef, Pastry Master, Italian Specialist" />
                            <span class="text-muted" style="font-size: 11px;">This title will be displayed next to your verified badge.</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sk-primary w-100 py-3 fw-bold">CREATE ACCOUNT</button>

                    <div class="text-center mt-4 small">
                        Already have an account? <a asp-controller="Account" asp-action="Login" class="fw-bold" style="color: #c26747;">Sign In Here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleChefFields(checkbox) {
            const container = document.getElementById('chefTitleContainer');
            if (checkbox.checked) {
                container.classList.remove('d-none');
            } else {
                container.classList.add('d-none');
            }
        }
    </script>
}
