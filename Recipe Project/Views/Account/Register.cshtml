@model Recipe_Project.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create an Account - Deliciousa Recipes";
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <h2 class="page-title text-white fw-bold">Sign Up</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Sign Up</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-12">
            <div class="form-card">
                <h3 class="fw-bold mb-1" style="font-family: 'Playfair Display', serif;">Join Our Foodie Community</h3>
                <p class="text-muted mb-4 small">Save favorites, leave star reviews, and publish your own recipes.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
                }

                <form asp-controller="Account" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-bold small">Full Name *</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Zain Malik" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold small">Email Address *</label>
                        <input asp-for="Email" class="form-control" placeholder="e.g. zain@example.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small">Password (Min 6 chars) *</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small">Confirm Password *</label>
                        <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-default btn-primary w-100 py-3 fw-bold">CREATE ACCOUNT</button>

                    <div class="text-center mt-4 small">
                        Already have an account? <a asp-controller="Account" asp-action="Login" class="text-warning fw-bold">Sign In Here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
