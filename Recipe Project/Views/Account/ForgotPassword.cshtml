@model Recipe_Project.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password - Deliciousa Recipes";
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <h2 class="page-title text-white fw-bold">Forgot Password</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Login" class="text-white-50">Login</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Forgot Password</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7 col-12">
            <div class="form-card p-4 p-md-5 bg-white rounded-3 shadow-sm border">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fdf2eb; color: #c26747; font-size: 24px;">
                        <i class="fa fa-key"></i>
                    </div>
                    <h3 class="fw-bold mb-2" style="font-family: 'Playfair Display', serif;">Forgot Your Password?</h3>
                    <p class="text-muted small mb-0">
                        Enter your registered email address and we'll send you a <strong>6-digit OTP</strong> verification code to reset your password.
                    </p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
                }

                <form asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="Email" class="form-label fw-bold small">Registered Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa fa-envelope-o"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="e.g. chef@example.com" required autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-sk-primary w-100 py-3 fw-bold">
                        SEND 6-DIGIT OTP
                    </button>

                    <div class="text-center mt-4 small">
                        Remember your password? 
                        <a asp-action="Login" class="fw-bold" style="color: #c26747;">Back to Sign In</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
