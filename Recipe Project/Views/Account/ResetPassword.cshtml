@model Recipe_Project.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Verify OTP & Reset Password - Deliciousa Recipes";
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <h2 class="page-title text-white fw-bold">Reset Password</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Account" asp-action="Login" class="text-white-50">Login</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Verify OTP</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-12">
            <div class="form-card p-4 p-md-5 bg-white rounded-3 shadow-sm border">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px; background-color: #fdf2eb; color: #c26747; font-size: 24px;">
                        <i class="fa fa-shield"></i>
                    </div>
                    <h3 class="fw-bold mb-2" style="font-family: 'Playfair Display', serif;">Enter 6-Digit OTP</h3>
                    <p class="text-muted small mb-0">
                        Please enter the 6-digit verification code sent to <br />
                        <strong class="text-dark">@Model.Email</strong>
                    </p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
                }

                <form asp-action="ResetPassword" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Email" />

                    <!-- 6-digit OTP Input -->
                    <div class="mb-4">
                        <label asp-for="Otp" class="form-label fw-bold small text-center d-block">6-Digit Verification Code</label>
                        <div class="d-flex justify-content-center">
                            <input asp-for="Otp" class="form-control text-center fw-bold" 
                                   maxlength="6" 
                                   pattern="\d{6}"
                                   autocomplete="one-time-code"
                                   placeholder="••••••" 
                                   style="font-size: 28px; letter-spacing: 12px; font-family: monospace; max-width: 260px; height: 60px; border: 2px solid #e0cfc6; border-radius: 8px;" 
                                   required autofocus />
                        </div>
                        <span asp-validation-for="Otp" class="text-danger small text-center d-block mt-1"></span>
                        <div class="text-center mt-1">
                            <small class="text-muted"><i class="fa fa-clock-o"></i> Code expires in 15 minutes</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-bold small">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa fa-lock"></i></span>
                            <input asp-for="NewPassword" class="form-control" type="password" placeholder="Minimum 6 characters" required />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-bold small">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="fa fa-lock"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Re-type new password" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-sk-primary w-100 py-3 fw-bold">
                        VERIFY OTP &amp; RESET PASSWORD
                    </button>
                </form>

                <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top small">
                    <div>
                        <span class="text-muted">Didn't receive the OTP?</span>
                        <form asp-action="ResendOtp" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@Model.Email" />
                            <button type="submit" class="btn btn-link p-0 fw-bold border-0 text-decoration-none" style="color: #c26747; vertical-align: baseline;">
                                Resend Code
                            </button>
                        </form>
                    </div>
                    <a asp-action="Login" class="text-muted text-decoration-none">Cancel &amp; Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>
