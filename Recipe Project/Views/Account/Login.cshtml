@model Recipe_Project.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In - Deliciousa Recipes";
}

<!-- Page Header Banner -->
<div class="page-title-area bg-image bg-parallax2" style="background-image: url('/images/header/header1.jpg'); background-size: cover; background-position: center;">
    <div class="container text-center">
        <h2 class="page-title text-white fw-bold">Sign In</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb justify-content-center bg-transparent mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Home</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">Login</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-4 py-md-5">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-12">
            <div class="form-card">
                <h3 class="fw-bold mb-1" style="font-family: 'Playfair Display', serif;">Welcome Back!</h3>
                <p class="text-muted mb-4 small">Log in to manage your recipes, bookmarks, and reviews.</p>

                <!-- Quick Recruiter / Reviewer Demo Logins -->
                <div class="p-3 mb-4 rounded-3 border" style="background: #fdfbf7; border-color: #eed7be !important;">
                    <div class="small fw-bold text-dark mb-2">💡 Quick Portfolio Demo Login:</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-dark" onclick="fillCreds('zain@recipeproject.com', 'Password123')">
                            👨‍🍳 Chef Zain (Admin)
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="fillCreds('sarah@example.com', 'Password123')">
                            🥗 Sarah (User)
                        </button>
                    </div>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger small py-2"></div>
                }

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold small">Email Address</label>
                        <input asp-for="Email" id="emailInput" class="form-control" placeholder="e.g. zain@recipeproject.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-bold small">Password</label>
                        <input asp-for="Password" id="passwordInput" class="form-control" type="password" placeholder="••••••••" required />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberCheck" />
                        <label class="form-check-label small text-muted" for="rememberCheck">Remember me on this browser</label>
                    </div>

                    <button type="submit" class="btn btn-sk-primary w-100 py-3 fw-bold">SIGN IN</button>

                    <div class="text-center mt-4 small">
                        Don't have an account? <a asp-controller="Account" asp-action="Register" class="fw-bold" style="color: #c26747;">Sign Up Free</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillCreds(email, password) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
}
